# Copy to apps/api/.env (gitignored). Never commit real values.

# Neon, pooled connection (host contains "-pooler"): used by the running API.
DATABASE_URL=
# Neon, direct connection: used only by `npm run migrate -w @spm/api`.
DATABASE_URL_UNPOOLED=

# mock (offline, deterministic) | replay (serves recorded stage_cache entries) | gemini
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Free-tier Flash model name from Google AI Studio.
GEMINI_MODEL=
# Minimum gap between two LLM calls in ms (60000 / free-tier RPM, with margin). 6500 is about 9 per minute.
LLM_MIN_INTERVAL_MS=6500
# Thinking depth for Gemini: minimal | low | medium | high
GEMINI_THINKING=low

# Replay provider: which provider and model recorded the cache entries (defaults: gemini, GEMINI_MODEL).
REPLAY_SOURCE_PROVIDER=
REPLAY_SOURCE_MODEL=

PORT=3001
# Maximum live runs per UTC day (protects the free quota). 0 = no cap.
DAILY_RUN_CAP=20
MAX_CONCURRENT_RUNS=2
RATE_LIMIT_RUNS_PER_HOUR=5
# Optional: if set, live runs need this code in the request body.
DEMO_ACCESS_CODE=
# Allowed browser origins, comma separated (for example the Vercel URL). Empty = no CORS headers.
CORS_ORIGIN=
LOG_LEVEL=info
NODE_ENV=development
