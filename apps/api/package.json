{
  "name": "@spm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@spm/exporters": "^0.0.0",
    "@spm/scheduler": "^0.0.0",
    "@spm/shared": "^0.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsc -b && node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations --database-url-var DATABASE_URL_UNPOOLED up",
    "migrate:down": "node --env-file-if-exists=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations --database-url-var DATABASE_URL_UNPOOLED down",
    "live-run": "tsc -b && node --env-file-if-exists=.env dist/scripts/live-run.js",
    "golden:record": "tsc -b && node --env-file-if-exists=.env dist/scripts/golden-record.js"
  }
}
