{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@spm/web"
      ],
      "port": 5173
    },
    {
      "name": "full-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock"
      ],
      "port": 5173
    },
    {
      "name": "api-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=apps/api/.env",
        "apps/api/dist/server.js"
      ],
      "port": 3001
    }
  ]
}