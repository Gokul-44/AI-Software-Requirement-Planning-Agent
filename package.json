{
  "name": "spm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared",
    "packages/scheduler",
    "packages/exporters"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "dev:web": "npm run dev -w @spm/web",
    "dev:api": "npm run dev -w @spm/api",
    "dev:tsc": "tsc -b --watch --preserveWatchOutput",
    "build": "tsc -b tsconfig.build.json && npm run build -w @spm/web",
    "build:api": "tsc -b apps/api",
    "start:api": "npm run start -w @spm/api",
    "migrate:deploy": "npm run migrate:deploy -w @spm/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "e2e": "npm run test:e2e",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fixture": "tsc -b tsconfig.build.json && node scripts/build-fixture.ts",
    "eval": "npm run eval -w @spm/api --",
    "golden:record": "npm run golden:record -w @spm/api --",
    "golden:export": "npm run golden:export -w @spm/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  },
  "description": "Turn a one-line software idea into a traceable, schedule-consistent project plan.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gokul-44/AI-Software-Requirement-Planning-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/Gokul-44/AI-Software-Requirement-Planning-Agent/issues"
  },
  "homepage": "https://github.com/Gokul-44/AI-Software-Requirement-Planning-Agent#readme"
}
